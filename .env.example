# ==============================================================================
# CIT Campus Scheduling and Venue Management Platform - Environment Config
# ==============================================================================

# Application Settings
APP_NAME="CIT Scheduler"
DEBUG=false
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Authentication (Generate a secure random key for production: openssl rand -hex 32)
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM="HS256"

# Database Configuration (PostgreSQL in production, SQLite for local development)
DATABASE_URL="sqlite:///./cit_scheduler.db"
# DATABASE_URL="postgresql://cit_user:cit_pass@localhost:5432/cit_db"

# LLM Configuration (Optional: system works 100% offline with NullLLM fallback)
# Leave empty to run in fully offline deterministic mode
LLM_API_KEY=""
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.0-flash"

# CP-SAT Constraint Solver Settings
SOLVER_TIME_LIMIT_SECONDS=120
SOLVER_NUM_WORKERS=8

# Frontend URL (for CORS and redirects)
FRONTEND_URL="http://localhost:5173"
